asd-tauri/dist/

# ============================================================
# 测试产物
# ============================================================
tests/backups/backup_*.json
backups/backup_*.json
test-results/
coverage/
*.lcov

# ============================================================
# 配置备份（项目特定）
# ============================================================
config_backup/

# ============================================================
# 项目备份文件（大文件，不应版本控制）
# ============================================================
AutoHotkeydemo.zip
*.zip.bak

# ============================================================
# E2E 测试产物
# ============================================================
asd-tauri/e2e/node_modules/
asd-tauri/e2e/reports/

# AHK 测试产物：每次跑 tests/run_all_tests.ahk 都会由 TestReporter.ExportReport()
# 生成一个带时间戳的 test_report_YYYYMMDD_HHMMSS.json（TD-032）。
# ⚠️ tests/reports/ 下已有 47 个历史文件是 tracked 的，gitignore 不会自动摘掉它们，
#    需要单独 untrack（按工程约定用 mv + git add -A，不用 git rm）；
#    latest.json / integration_full_report.json 是固定名，不在此列。
tests/reports/test_report_*.json
# 独立脚本（tests/test_*.ahk）的固定名报告，同样是每次运行都会刷新的产物
tests/reports/standalone/

# E2E 浏览器驱动目录：driver 与机器的 WebView2 运行时版本强绑定，
# 且随包附带的 Driver_Notes/（EULA/LICENSE/credits）约 21MB，均不应入版本控制。
# （msedgedriver.exe 另由上方 `*.exe` 覆盖，此处显式排除整个目录以免漏掉 Driver_Notes）
asd-tauri/e2e/drivers/

# ============================================================
# Git Worktree 隔离工作区
# ============================================================
.worktrees/

# ============================================================
# 本地调试探针脚本与临时输出（非项目产物）
# ============================================================
_diag.ahk
_mock.ahk
_rt.ahk
_cr1_test_out.txt
_cr2_out.txt
_cr2_stderr.txt
syntax_check.err

# 图谱分析中间产物（生成脚本保留，原始数据可复现）
.review-analysis/graph-raw.json
.review-analysis/ahk-includes.json

# Python 工具链产物（tools/**/*.py）
__pycache__/
*.pyc

# ============================================================
# AHK 基准原始输出（可复现产物，不入库）
# ============================================================
tools/ahk-bench/results/
tools/ahk-bench/lib/*_result.log
