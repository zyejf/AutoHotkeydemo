#!/bin/sh
# ============================================================
# reference-transaction hook（版本化，位于 scripts/hooks/）
# 安装：scripts/install-hooks.sh 或 scripts/install-hooks.ps1
# 作用：在 ref 事务**提交前**否决「WorkBuddy 托管 worktree 嵌套 ref 被删除」。
#
# 背景（2026-09-16 SEV2 事故，见 deliverables/engineering-assurance/
#       incident-git-ref-loss-drill-2026-09-19.md）：
#   分支 refs/heads/workbuddy/main-5f18c6a6 的引用文件被外部删除，
#   一天内触发 4 次（reset / commit / merge --ff-only / stash），
#   一度真实丢失 3 个提交对象。这是 git 唯一能在事务提交前否决的钩子，
#   因此是唯一「触发者无关」的硬拦截。
#
# 为什么只锁 refs/heads/workbuddy/* 而不是所有嵌套 ref：
#   普通分支名 feature/xxx、fix/xxx 同样含 "/"，若一并否决会误伤日常删分支。
#   WorkBuddy 托管 worktree 的命名固定为 workbuddy/<源分支>-<hash>，精准匹配即可。
#
# 应急开关：确需清理时设 ASD_ALLOW_NESTED_REF_DELETE=1（例如 git worktree prune 后
#   清理孤儿 ref），删除动作仍会打印告警以便事后追溯。
# ============================================================

[ "$1" = "prepared" ] || exit 0

while read -r old new ref; do
    case "$ref" in
        refs/heads/workbuddy/*)
            # new 全零 = 该 ref 正在被删除
            case "$new" in
                0000000000000000000000000000000000000000)
                    if [ "${ASD_ALLOW_NESTED_REF_DELETE:-0}" = "1" ]; then
                        echo "[WARN] 已按 ASD_ALLOW_NESTED_REF_DELETE=1 放行嵌套 ref 删除: $ref" >&2
                        continue
                    fi
                    echo "" >&2
                    echo "[BLOCKED] 禁止删除 WorkBuddy 托管 worktree 的嵌套 ref: $ref" >&2
                    echo "  旧值: $old" >&2
                    echo "" >&2
                    echo "  若是误触发（例如 reset/commit/merge 引发），请改到主 worktree 操作：" >&2
                    echo "    D:/1demo/AutoHotkeydemo（分支 main，顶层 ref）" >&2
                    echo "  若确需清理，设 ASD_ALLOW_NESTED_REF_DELETE=1 后重试。" >&2
                    echo "  处置 runbook: docs/developer-guide.md §worktree 嵌套 ref 事故处置" >&2
                    echo "" >&2
                    exit 1
                    ;;
            esac
            ;;
    esac
done

exit 0
