#!/bin/sh
# ============================================================
# commit-msg hook（版本化，位于 scripts/hooks/）
# 安装：scripts/install-hooks.sh 或 scripts/install-hooks.ps1
# 作用：校验提交信息符合 Conventional Commits 规范
# 详见 docs/commit-convention.md
#
# 注意：scope 正则为 [a-z-]+，**不含数字**；如需含数字的 scope 需同步修改此处。
# ============================================================

msg_file="$1"
msg=$(cat "$msg_file")

# 跳过 merge 提交和 revert 提交
if echo "$msg" | grep -qE '^(Merge |Revert )'; then
    exit 0
fi

# 提取第一行（subject）
first_line=$(echo "$msg" | head -n1)

# Conventional Commits 正则
# 格式: <type>(<scope>)!: <描述> 或 <type>: <描述>
# type 必填，全小写
# scope 可选，全小写 + 连字符（不含数字）
# ! 可选，标注 BREAKING CHANGE
pattern='^(feat|fix|docs|style|refactor|test|chore|perf|ci|build)(\([a-z-]+\))?!?: .+'

if ! echo "$first_line" | grep -qE "$pattern"; then
    echo "========================================================"
    echo "ERROR: 提交信息不符合 Conventional Commits 规范"
    echo "========================================================"
    echo "格式: <type>(<scope>): <描述>"
    echo ""
    echo "允许的 type:"
    echo "  feat        新功能"
    echo "  fix         Bug 修复"
    echo "  docs        文档变更"
    echo "  style       代码风格"
    echo "  refactor    重构"
    echo "  test        测试相关"
    echo "  chore       杂项"
    echo "  perf        性能优化"
    echo "  ci          CI/CD"
    echo "  build       构建系统"
    echo ""
    echo "允许的 scope（可选，仅小写字母与连字符，不含数字）:"
    echo "  asd-domain  asd-ipc-protocol  asd-application"
    echo "  asd-tauri   asd-test-harness  ahk"
    echo "  test        ci                docs"
    echo "  config"
    echo ""
    echo "示例:"
    echo "  feat(asd-ipc-protocol): 新增 HotkeyMerger 热键合并器"
    echo "  fix(asd-test-harness): 修复 unique_pipe_name 并发碰撞"
    echo "  docs: 更新 README"
    echo ""
    echo "当前提交信息: $first_line"
    echo "详见 docs/commit-convention.md"
    echo "========================================================"
    exit 1
fi

# 检查描述不应以句号结尾（中文句号或英文句点）
if echo "$first_line" | grep -qE '^[^:]+: .+[。.]$'; then
    echo "ERROR: 提交信息描述不应以句号结尾"
    echo "当前: $first_line"
    echo "详见 docs/commit-convention.md"
    exit 1
fi

# 检查描述长度（首行不超过 72 字符建议，中文字符按 2 计算近似）
# 此处仅警告，不阻止提交
first_line_len=$(echo "$first_line" | wc -m)
if [ "$first_line_len" -gt 80 ]; then
    echo "WARNING: 提交信息首行较长（${first_line_len} 字符），建议不超过 72 字符"
fi

echo "OK: 提交信息格式正确"
exit 0
