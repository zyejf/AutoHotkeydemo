{
  "$schema": "https://raw.githubusercontent.com/nicehash/Tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ASD - 技能管理器",
  "version": "0.1.0",
  "identifier": "com.asd.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ASD - 技能管理器",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-2.0-only",
    "licenseFile": "../../LICENSE",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "ahk_executor/executor.ahk": "ahk_executor/executor.ahk",
      "ahk_executor/ipc_client.ahk": "ahk_executor/ipc_client.ahk",
      "ahk_executor/hotkey_hook.ahk": "ahk_executor/hotkey_hook.ahk",
      "ahk_executor/sender.ahk": "ahk_executor/sender.ahk",
      "ahk_executor/joystick.ahk": "ahk_executor/joystick.ahk",
      "ahk_executor/high_res_clock.ahk": "ahk_executor/high_res_clock.ahk",
      "ahk_executor/AutoHotkey64.exe": "ahk_executor/AutoHotkey64.exe",
      "ahk_executor/asd_executor.bat": "ahk_executor/asd_executor.bat",
      "third-party/AutoHotkey-license.txt": "third-party/AutoHotkey-license.txt",
      "third-party/THIRD-PARTY-NOTICES.md": "third-party/THIRD-PARTY-NOTICES.md",
      "../../README.md": "README.md",
      "../../docs/user-guide.md": "docs/user-guide.md",
      "../../docs/troubleshooting.md": "docs/troubleshooting.md",
      "../../LICENSE": "LICENSE"
    },
    "publisher": "ASD Team",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
